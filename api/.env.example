PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=designer_orders
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Object storage (bucket) buat gambar. Kompatibel S3: R2, S3, Railway Bucket, dll.
# Di DB cuma disimpan URL-nya, filenya ada di bucket.
# Nama bawaan Railway Bucket tanpa awalan (ENDPOINT, REGION, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY) juga dibaca;
# kalau keduanya ada, yang berawalan S3_ didahulukan. Alamat gambar di Railway otomatis dari RAILWAY_PUBLIC_DOMAIN
# (S3_PUBLIC_URL opsional, untuk menimpa); S3_FORCE_PATH_STYLE opsional (default false).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publik dasar buat akses file, mis. https://cdn.domainmu.com
S3_PUBLIC_URL=
# true kalau provider mewajibkan path-style (mis. MinIO). R2/S3/Railway biasanya false.
S3_FORCE_PATH_STYLE=false
